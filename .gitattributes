# ----------------------------------------------------------------------
# 1. LINE ENDING AUTO-DETECTION
# ----------------------------------------------------------------------
# Handle line endings automatically for text files and leave binary alone
* text=auto

# ----------------------------------------------------------------------
# 2. FORCE LF FOR CROSS-PLATFORM TEXT FILES
# ----------------------------------------------------------------------
# Code files must use LF (Unix) line endings on checkout across Windows/Mac/Linux
*.c           text eol=lf
*.cc          text eol=lf
*.cpp         text eol=lf
*.cs          text eol=lf
*.css         text eol=lf
*.go          text eol=lf
*.h           text eol=lf
*.html        text eol=lf
*.java        text eol=lf
*.js          text eol=lf
*.json        text eol=lf
*.jsx         text eol=lf
*.kt          text eol=lf
*.md          text eol=lf
*.py          text eol=lf
*.rb          text eol=lf
*.rs          text eol=lf
*.sh          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.vue         text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.svg         text eol=lf

# Documentation and configs
*.txt         text eol=lf
*.ini         text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# ----------------------------------------------------------------------
# 3. FORCE CRLF FOR SPECIFIC WINDOWS FILES
# ----------------------------------------------------------------------
# Files that explicitly require Windows carriage returns
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf

# ----------------------------------------------------------------------
# 4. EXPLICIT BINARY FILES (PREVENTS CORRUPTION)
# ----------------------------------------------------------------------
# Tell Git not to touch line endings or attempt to merge these files
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.webp        binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.mp4         binary

# ----------------------------------------------------------------------
# 5. GIT LFS (LARGE FILE STORAGE) - OPTIONAL
# ----------------------------------------------------------------------
# Uncomment these if you use Git LFS to track heavy media or assets
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.zip filter=lfs diff=lfs merge=lfs -text
